# Base de datos Postgres (Supabase, Vercel Postgres, Neon, etc.)
DATABASE_URL="postgresql://usuario:password@host:5432/basededatos"
# Opcional pero recomendado para Prisma con pooler de Supabase.
DIRECT_URL="postgresql://usuario:password@host:5432/basededatos"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="genera_uno_con_openssl_rand_-base64_32"

# IA — se intenta Gemini primero y después los proveedores de respaldo configurados.
# Necesitas al menos una de estas claves.
GEMINI_API_KEY="AIza..."
GEMINI_MODEL="gemini-3.6-flash"
AI_TIMEOUT_MS="30000"
GROQ_API_KEY="gsk_..."
CEREBRAS_API_KEY="csk_..."
OPENROUTER_API_KEY="sk-or-..."
MISTRAL_API_KEY="..."

# Stripe — suscripción mensual Pro.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_ID_PRO="price_..."
