datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  passwordHash  String
  createdAt     DateTime  @default(now())

  plan          Plan      @default(FREE)
  stripeCustomerId       String?  @unique
  stripeSubscriptionId   String?  @unique
  stripeCurrentPeriodEnd DateTime?

paddleCustomerId     String? @unique
  paddleSubscriptionId String? @unique
  
brand         String?
  audience      String?
  style         String?
  notes         MemoryNote[]

  profanityLevel String  @default("none")
  personality    String?
  speakingStyle  String?
  userProfile    String?

  // Reto diario: 20 sugerencias generadas una vez al día,
  // guardadas como texto (JSON) junto con la fecha de generación.
  dailyChallenges     String?
  dailyChallengesDate String?

  conversations Conversation[]
  usageLogs     UsageLog[]
}

enum Plan {
  FREE
  PRO
}

model MemoryNote {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
}

model Conversation {
  id        String    @id @default(cuid())
  mode      String    @default("free")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  messages  Message[]
}

model Message {
  id             String       @id @default(cuid())
  role           String
  content        String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
}

model UsageLog {
  id           String   @id @default(cuid())
  date         String
  messageCount Int      @default(0)
  strategistCount Int    @default(0)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String

  @@unique([userId, date])
}
